{
  "name": "TEMPLATE_NAME",
  "version": "0.0.0",
  "type": "module",
  "keywords": [],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TEMPLATE_OWNER/TEMPLATE_NAME.git"
  },
  "bugs": {
    "url": "https://github.com/TEMPLATE_OWNER/TEMPLATE_NAME/issues"
  },
  "homepage": "https://github.com/TEMPLATE_OWNER/TEMPLATE_NAME#readme",
  "scripts": {
    "dev": "SSG_GEN=true tsx src/dev.ts",
    "build": "npm run clean && npm run build:client && npm run build:server && npm run build:ssg",
    "build:client": "vite build --mode production --outDir dist/client --ssrManifest",
    "build:server": "vite build --mode production --ssr src/server.ts --outDir dist/server",
    "build:ssg": "NODE_ENV=production SSG_GEN=true tsx src/ssg.ts --use-system-ca",
    "start": "NODE_ENV=production node dist/server/server.js",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{js,jsx,ts,tsx,html,css}\" --log-level silent",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "clean": "node -e \"import('node:fs').then(fs => fs.rmSync('dist', { recursive: true, force: true }))\""
  },
  "dependencies": {
    "@fastify/compress": "^9.2.2",
    "@fastify/cookie": "^11.1.3",
    "@fastify/middie": "^9.3.5",
    "dotenv": "^18.0.8",
    "fastify": "^5.12.7",
    "i18next": "^26.4.7",
    "i18next-browser-languagedetector": "^8.2.1",
    "i18next-fs-backend": "^2.6.9",
    "i18next-http-backend": "^4.0.3",
    "i18next-http-middleware": "^3.9.9",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.0.20",
    "react-router": "^8.4.0",
    "sirv": "^3.0.2",
    "tinyglobby": "^0.2.17"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@rolldown/plugin-babel": "^0.2.4",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "@types/picomatch": "^4.0.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/react-router": "^5.1.20",
    "@vitejs/plugin-react": "^6.1.2",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "parse5": "^8.0.1",
    "picomatch": "^4.0.7",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  },
  "engines": {
    "node": ">=22"
  }
}
